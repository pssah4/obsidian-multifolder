{
    "name": "multifolder",
    "version": "2.16.0",
    "description": "Adds external folders to your vault as seamless, native-feeling directories. Creates virtual mount points that map real filesystem paths into the vault.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint main.ts 'src/**/*.ts'",
        "check:ui-text": "node scripts/check-ui-text.mjs",
        "test": "vitest run",
        "validate": "npm run lint && npm run check:ui-text && npm run build && npm test",
        "hooks:install": "git config core.hooksPath .githooks",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "deploy": "bash deploy-local.sh --build"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "virtual-filesystem",
        "multifolder"
    ],
    "author": "Sebastian Hanke",
    "license": "MIT",
    "devDependencies": {
        "@eslint/json": "^1.1.0",
        "@types/node": "^20.11.16",
        "@types/ssh2": "^1.15.4",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.0",
        "builtin-modules": "^3.3.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.2.0",
        "eslint-plugin-obsidianmd": "^0.1.9",
        "obsidian": "^1.12.0",
        "tslib": "2.6.2",
        "typescript": "5.3.3",
        "typescript-eslint": "^8.56.0",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.750.0",
        "chokidar": "^3.6.0",
        "ssh2-sftp-client": "^11.0.0",
        "webdav": "^5.9.0"
    },
    "overrides": {
        "fast-xml-parser": "^5.7.0",
        "fast-xml-builder": "^1.1.7",
        "brace-expansion": "^2.1.4",
        "@humanfs/node": "^0.16.8",
        "fast-uri": "^3.1.7",
        "js-yaml": "^4.3.2",
        "nanoid": "^3.3.18",
        "postcss": "^8.5.23",
        "vite": "^8.0.16"
    }
}
